# .env.example — copy to .env and fill in real values before deploying.
# The app runs fine with none of these set (see the defaults noted below),
# but you should set at least JWT_SECRET before any real deployment.

# ---------- core ----------
PORT=4000
# Random secret used to sign access tokens. REQUIRED in production and must be 48+ chars.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# ---------- logging ----------
# error | warn | info | http | debug — "info" is a sensible production default.
# Set to "http" to also log every request (method, path, status, duration).
LOG_LEVEL=info

# ---------- rate limiting ----------
# Max requests per IP per 60-second window across the whole API.
RATE_LIMIT_MAX=120

# ---------- CORS ----------
# Comma-separated list of allowed origins, e.g.:
#   ALLOWED_ORIGINS=https://portal.yourdomain.com,https://admin.yourdomain.com
# Leave blank to allow all origins (fine for local/demo use, not for production).
ALLOWED_ORIGINS=

# ---------- storage provider ----------
# local | s3 | r2 | supabase — see lib/storage/. Only "local" has been
# tested in this project so far (see QA_AUDIT_REPORT.md).
STORAGE_PROVIDER=local

# S3 (only used when STORAGE_PROVIDER=s3)
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Cloudflare R2 (only used when STORAGE_PROVIDER=r2)
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Supabase
AUTH_PROVIDER=json
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_AUTH_REDIRECT_URL=

# Supabase Storage (only used when STORAGE_PROVIDER=supabase)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=

# ---------- database ----------
# json = local/small single-instance datastore; postgres = production database.
DB_DRIVER=json
DATABASE_URL=

# Only read by repositories/prismaClient.js (the not-yet-wired-in Postgres
# layer — see documentation/POSTGRES_MIGRATION.md). Has no effect on the
# app as it runs today; controls Prisma's query-log verbosity once that
# layer is connected.
NODE_ENV=