# EcoStream production environment reference
# Secrets belong in Render Environment Variables, never in GitHub.

PORT=4000
NODE_ENV=production
AUTH_PROVIDER=supabase
STORAGE_PROVIDER=supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=documents
SUPABASE_AUTH_REDIRECT_URL=
ALLOWED_ORIGINS=
LOG_LEVEL=info
RATE_LIMIT_MAX=120

# DATABASE_URL / DB_DRIVER are intentionally not used for production.
# Supabase PostgreSQL is the production source of truth through authenticated PostgREST.
